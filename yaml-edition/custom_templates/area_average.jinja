{#-
  Area Averages, without the integration.

  GENERATED by yaml-edition/generate.py — re-run it rather than editing here.

  area_stats(area_id) returns a JSON object describing one area's temperature
  average. It is parsed once per trigger in the package's `variables:` block,
  so the whole computation happens a single time per update rather than once
  per attribute.

  Membership is resolved live from area_entities(), so a sensor moved into an
  area is picked up on the next trigger with no regeneration. Two things are
  baked in because Jinja cannot see them: SKIP (entities whose registry
  entity_category marks them diagnostic or config — the integration filters
  these at runtime) and the area list in the package itself.
-#}

{%- set SKIP = ["sensor.455d_temperature", "sensor.apollo_msr_2_b22324_esp_temperature", "sensor.apollo_plt_1_a84e64_esp_temperature", "sensor.bedroom_door_device_temperature", "sensor.bedroom_window_device_temperature", "sensor.cooler_1b80_temperature", "sensor.fridge_probe_temperature_2", "sensor.front_door_device_temperature", "sensor.ft8_1_battery_temperature", "sensor.irk_capture_internal_temp", "sensor.kettle_temperature", "sensor.mmwave_office_esp_temperature", "sensor.office_door_device_temperature", "sensor.office_temperature", "sensor.projector_screen_position_device_temperature", "sensor.refrigerator_temperature", "sensor.slzb_06_zigbee_bluetooth_d9d550_core_chip_temp", "sensor.slzb_06_zigbee_bluetooth_d9d550_zigbee_chip_temp"] -%}
{%- set LABEL = 'exclude_average' -%}
{%- set UNIT = '°F' -%}
{%- set STALE_HOURS = 24 -%}
{%- set BATTERY_PCT = 20 -%}

{%- macro _name(e) -%}
{#- A generic name identifies nothing: the Office alone has three sensors
    whose friendly_name is just "Temperature". Fall back to the entity_id. -#}
{%- set fn = state_attr(e, 'friendly_name') -%}
{%- if fn is none or (fn | length) < 4
       or (fn | lower) in ['temp', 'temperature', 'battery', 'sensor'] -%}
{{- e -}}
{%- else -%}
{{- fn -}}
{%- endif -%}
{%- endmacro -%}

{%- macro area_stats(area) -%}
{%- set ns = namespace(
      members=[], excluded=[], offline=[], stale=[], batt=[], vals=[],
      i_off=[], i_stale=[], i_batt=[], seen=[]) -%}
{%- for e in area_entities(area) | sort -%}
  {#- Never average an average. Both this twin and the integration publish
      member_count, so this one test keeps either of them out of the mean
      without needing to know their entity_ids. -#}
  {%- if e[:7] == 'sensor.' and e not in SKIP
         and state_attr(e, 'member_count') is none
         and state_attr(e, 'device_class') == 'temperature' -%}
    {%- set did = device_id(e) -%}
    {%- set tags = labels(e) + (labels(did) if did else []) -%}
    {%- if LABEL in tags -%}
      {%- set ns.excluded = ns.excluded + [e] -%}
    {%- else -%}
      {%- set ns.members = ns.members + [e] -%}
      {%- set s = states(e) -%}
      {%- if is_number(s) -%}
        {#- convert into the average's unit before it joins the mean -#}
        {%- set mu = state_attr(e, 'unit_of_measurement') -%}
        {%- set v = s | float -%}
        {%- if mu == '°C' and UNIT == '°F' -%}{%- set v = v * 1.8 + 32 -%}
        {%- elif mu == '°F' and UNIT == '°C' -%}{%- set v = (v - 32) / 1.8 -%}
        {%- endif -%}
        {%- set ns.vals = ns.vals + [v | round(2)] -%}
        {#- last_reported resets on restart, so staleness here is honest only
            since the last restart; the integration persists it instead -#}
        {%- set last = states[e].last_reported or states[e].last_changed -%}
        {%- set age = ((as_timestamp(now()) - as_timestamp(last)) / 3600) | round(0) -%}
        {%- if age >= STALE_HOURS -%}
          {%- set ns.stale = ns.stale + [e] -%}
          {%- set ns.i_stale = ns.i_stale + [_name(e) ~ ': no data for ' ~ (age | int) ~ ' h'] -%}
        {%- endif -%}
      {%- else -%}
        {%- set ns.offline = ns.offline + [e] -%}
        {%- set ns.i_off = ns.i_off + [_name(e) ~ ': offline'] -%}
      {%- endif -%}
      {%- if did -%}
        {%- for b in device_entities(did) -%}
          {%- if b not in ns.seen and state_attr(b, 'device_class') == 'battery' -%}
            {%- set ns.seen = ns.seen + [b] -%}
            {%- if b[:7] == 'sensor.' and is_number(states(b))
                   and (states(b) | float) <= BATTERY_PCT -%}
              {%- set ns.batt = ns.batt + [b] -%}
              {%- set ns.i_batt = ns.i_batt + [_name(b) ~ ': battery ' ~ (states(b) | float | round(0) | int) ~ '%'] -%}
            {%- elif b[:14] == 'binary_sensor.' and is_state(b, 'on') -%}
              {%- set ns.batt = ns.batt + [b] -%}
              {%- set ns.i_batt = ns.i_batt + [_name(b) ~ ': low battery'] -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{#- stale members hold a number but are not trusted into the mean -#}
{%- set live = [] -%}
{%- set ns2 = namespace(live=[]) -%}
{%- for e in ns.members -%}
  {%- if e not in ns.offline and e not in ns.stale and is_number(states(e)) -%}
    {%- set mu = state_attr(e, 'unit_of_measurement') -%}
    {%- set v = states(e) | float -%}
    {%- if mu == '°C' and UNIT == '°F' -%}{%- set v = v * 1.8 + 32 -%}
    {%- elif mu == '°F' and UNIT == '°C' -%}{%- set v = (v - 32) / 1.8 -%}
    {%- endif -%}
    {#- Unrounded: rounding each value before min/max/spread loses a cent
        against the integration, which subtracts first and rounds last. -#}
    {%- set ns2.live = ns2.live + [v] -%}
  {%- endif -%}
{%- endfor -%}
{%- set issues = ns.i_off + ns.i_stale + ns.i_batt -%}
{%- set n = ns2.live | count -%}
{%- set mc = ns.members | count -%}
{%- set summary =
      'no sensors reporting' if n == 0
      else ('1 sensor' if (mc == 1 and n == 1)
      else ((n ~ ' of ' ~ mc ~ ' sensors') if n < mc else (mc ~ ' sensors'))) -%}
{{- {
  'mean': ((ns2.live | sum) / n) | round(2) if n > 0 else none,
  'minimum': (ns2.live | min) | round(2) if n > 0 else none,
  'maximum': (ns2.live | max) | round(2) if n > 0 else none,
  'spread': ((ns2.live | max) - (ns2.live | min)) | round(2) if n > 1 else none,
  'member_count': mc,
  'reporting': n,
  'summary': summary,
  'healthy': (n > 0 and issues | count == 0),
  'sensors': ns.members,
  'excluded': ns.excluded,
  'offline': ns.offline,
  'stale': ns.stale,
  'low_battery': ns.batt,
  'issues': issues,
  'issue': issues | join('; ') if issues else none,
} | to_json -}}
{%- endmacro -%}
